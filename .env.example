# Backend application
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB is required for accounts, document metadata, and query history.
MONGO_URI=mongodb://localhost:27017/aerorag

# Replace this placeholder before using authenticated endpoints.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Leave the key blank for deterministic demo mode.
GOOGLE_API_KEY=
DEMO_MODE=true
LLM_PROVIDER=google
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# The vector store falls back to local persistence if the Chroma service is unavailable.
VECTOR_DB_URL=http://localhost:8000
VECTOR_DIMENSION=768
COLLECTION_NAME=aerorag_chunks
VECTOR_METRIC=cosine
VECTOR_STORE_PATH=
