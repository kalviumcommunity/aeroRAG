MONGO_URI=mongodb://localhost:27017/aerorag
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# LLM API Configuration (Milestone 3.12)
# Provide either GOOGLE_API_KEY or GEMINI_API_KEY for Google Gemini access
GOOGLE_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=30000
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=500
LLM_TOP_P=0.8

# Vector Database Configuration
VECTOR_DB_URL=http://localhost:8000
VECTOR_DIMENSION=768
COLLECTION_NAME=aerorag_chunks
VECTOR_METRIC=cosine

# Server Configuration
PORT=5000
NODE_ENV=development
DEMO_MODE=false
FRONTEND_URL=http://localhost:5173
